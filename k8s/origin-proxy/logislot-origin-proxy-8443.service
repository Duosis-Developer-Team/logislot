# LogiSlot origin proxy — Cloudflare HTTPS origin bu porta baglanir.
#
# NEDEN iptables DEGIL: node1:8443 -> REDIRECT 30772 -> IPVS -> node2:443
# zincirinde netfilter NAT ile IPVS ust uste NAT yapiyor ve paket cevapsiz
# kaliyor (denendi: 8443 zaman asimina dustu, REDIRECT sayaci artiyordu ama
# SYN-ACK donmuyordu). socat YENI bir TCP baglantisi actigi icin bu catisma
# hic olusmuyor.
#
# NEDEN 80/443 DEGIL: onlar Hermes'in (iptables 80->30880, 443->30443) ve bir
# node'un 80/443'u ayni anda iki yere gidemez. Cloudflare origin'e sinirli
# portlardan baglanir (HTTPS: 443, 8443, 2053, 2083, 2087, 2096); 8443 secildi.
#
# Hedef 30772 = ingress-nginx-controller (class `nginx`) HTTPS NodePort'u.
[Unit]
Description=LogiSlot origin proxy 8443 -> ingress-nginx 30772
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/socat TCP-LISTEN:8443,fork,reuseaddr,backlog=128 TCP:84.247.180.172:30772
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
