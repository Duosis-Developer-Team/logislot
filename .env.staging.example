# LogiSlot staging ortam degiskenleri — ORNEK DOSYA.
# GERCEK SECRET KOYMAYIN; kopyalayip (.env.staging) sunucuda doldurun.

# --- Veritabani ---
POSTGRES_USER=logislot
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=logislot

# --- API ---
# openssl rand -hex 32
LOGISLOT_SECRET_KEY=CHANGE_ME_openssl_rand_hex_32
LOGISLOT_CORS_ORIGINS=["https://staging.example.com"]
LOGISLOT_PUBLIC_WEB_URL=https://staging.example.com

# --- E-posta (log_only ile baslayin; SMTP hazir olunca smtp yapin) ---
LOGISLOT_EMAIL_PROVIDER=log_only
LOGISLOT_SMTP_HOST=
LOGISLOT_SMTP_PORT=587
LOGISLOT_SMTP_USERNAME=
LOGISLOT_SMTP_PASSWORD=
LOGISLOT_SMTP_FROM_EMAIL=
LOGISLOT_SMTP_FROM_NAME=LogiSlot

# --- Web build ---
NEXT_PUBLIC_API_URL=https://api.staging.example.com
