# --- Backend (FastAPI) ---
# Yerel gelistirmede compose db portu 5433'e maplenmistir (5432 çakışmasın diye).
LOGISLOT_DATABASE_URL=postgresql+asyncpg://logislot:logislot@localhost:5433/logislot
LOGISLOT_SECRET_KEY=dev-secret-change-me
LOGISLOT_ENVIRONMENT=development
LOGISLOT_CORS_ORIGINS=["http://localhost:3000"]
# E-posta sablonlarindaki portal linki
LOGISLOT_PUBLIC_WEB_URL=http://localhost:3010

# --- E-posta (Sprint 9) ---
# log_only (varsayilan): gondermez, email_logs tablosuna yazar.
# smtp: gercek gonderim — asagidaki SMTP_* alanlarini doldurun.
LOGISLOT_EMAIL_PROVIDER=log_only
LOGISLOT_SMTP_HOST=
LOGISLOT_SMTP_PORT=587
LOGISLOT_SMTP_USERNAME=
LOGISLOT_SMTP_PASSWORD=
LOGISLOT_SMTP_FROM_EMAIL=
LOGISLOT_SMTP_FROM_NAME=LogiSlot
LOGISLOT_SMTP_USE_TLS=true
LOGISLOT_SMTP_TIMEOUT_SECONDS=10

# --- Parola politikasi (Sprint 9) ---
# /auth/change-password'da uygulanir; production'da yaygin/demo parolalar da engellenir.
LOGISLOT_PASSWORD_MIN_LENGTH=10
LOGISLOT_PASSWORD_REQUIRE_SPECIAL=true

# --- Frontend (Next.js) ---
# Compose ile calisirken API host portu 8010'dur; yerel uvicorn'da 8000 kullanabilirsiniz.
NEXT_PUBLIC_API_URL=http://localhost:8010
# Login ekranindaki demo hesap ipucu + form on-doldurma (BUILD-TIME, opsiyonel).
# Bos birakilirsa kapalidir; prod build'i bos gecer, boylece demo e-posta/parola
# bundle'a hic girmez. Yerel gelistirme icin:
# NEXT_PUBLIC_DEMO_CREDENTIALS={"password":"Demo123!","emails":{"supplier":"tedarikci@anadoluun.com","admin":"admin@cakesbakes.com","platform":"admin@logislot.com"}}

# --- Hermes Ticket Hub entegrasyonu ---
# Hermes canonical destek sistemidir; LogiSlot yalnizca consumer'dir.
# BOS BIRAKILIRSA: ticket ozelligi yerelde calisir (talep kaydedilir, outbox'ta
# bekler) fakat Hermes'e gonderim denenmez ve Platform > Ticket Yonlendirmesi
# ekrani "yapilandirilmadi" gosterir. Bu bilincli bir gecis durumudur.
LOGISLOT_HERMES_SUPPORT_BASE_URL=
LOGISLOT_HERMES_SUPPORT_APPLICATION_CODE=logislot
LOGISLOT_HERMES_SUPPORT_CLIENT_ID=
# GERCEK DEGER BURAYA YAZILMAZ — secret/manager'dan gelir.
LOGISLOT_HERMES_SUPPORT_TOKEN=
# Gelen webhook imzasinin dogrulandigi paylasilan sir. BOS ise uc nokta
# FAIL-CLOSED calisir (her istegi 401 ile reddeder) — bu bilerek boyledir.
LOGISLOT_HERMES_SUPPORT_WEBHOOK_SECRET=
# Rotasyon sirasinda eski sir kisa sure kabul edilir.
LOGISLOT_HERMES_SUPPORT_WEBHOOK_SECRET_PREVIOUS=
LOGISLOT_HERMES_SUPPORT_WEBHOOK_KEY_ID=v1
LOGISLOT_HERMES_SUPPORT_TIMEOUT_SECONDS=8
LOGISLOT_HERMES_SUPPORT_CATALOG_TTL_SECONDS=300
# Hermes'in bu kuruluma olay gonderdigi adres (yalnizca dokumantasyon/health).
LOGISLOT_HERMES_SUPPORT_CALLBACK_BASE_URL=http://localhost:8010

# --- Ticket ozelligi ---
LOGISLOT_TICKETING_ENABLED=true
LOGISLOT_TICKET_OUTBOX_INTERVAL_SECONDS=20
LOGISLOT_TICKET_RECONCILIATION_INTERVAL_SECONDS=900
LOGISLOT_TICKET_INBOX_RECOVERY_INTERVAL_SECONDS=300
