# --- Backend (FastAPI) ---
# Yerel gelistirmede compose db portu 5433'e maplenmistir (5432 çakışmasın diye).
LOGISLOT_DATABASE_URL=postgresql+asyncpg://logislot:logislot@localhost:5433/logislot
LOGISLOT_SECRET_KEY=dev-secret-change-me
LOGISLOT_ENVIRONMENT=development
LOGISLOT_CORS_ORIGINS=["http://localhost:3000"]
# E-posta sablonlarindaki portal linki
LOGISLOT_PUBLIC_WEB_URL=http://localhost:3010

# --- E-posta (Sprint 9) ---
# log_only (varsayilan): gondermez, email_logs tablosuna yazar.
# smtp: gercek gonderim — asagidaki SMTP_* alanlarini doldurun.
LOGISLOT_EMAIL_PROVIDER=log_only
LOGISLOT_SMTP_HOST=
LOGISLOT_SMTP_PORT=587
LOGISLOT_SMTP_USERNAME=
LOGISLOT_SMTP_PASSWORD=
LOGISLOT_SMTP_FROM_EMAIL=
LOGISLOT_SMTP_FROM_NAME=LogiSlot
LOGISLOT_SMTP_USE_TLS=true
LOGISLOT_SMTP_TIMEOUT_SECONDS=10

# --- Parola politikasi (Sprint 9) ---
# /auth/change-password'da uygulanir; production'da yaygin/demo parolalar da engellenir.
LOGISLOT_PASSWORD_MIN_LENGTH=10
LOGISLOT_PASSWORD_REQUIRE_SPECIAL=true

# --- Frontend (Next.js) ---
# Compose ile calisirken API host portu 8010'dur; yerel uvicorn'da 8000 kullanabilirsiniz.
NEXT_PUBLIC_API_URL=http://localhost:8010
